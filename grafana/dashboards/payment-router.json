{
  "title": "Payment Router",
  "uid": "payment-router",
  "timezone": "browser",
  "schemaVersion": 38,
  "refresh": "10s",
  "panels": [
    {
      "id": 1,
      "title": "HTTP Request Rate (req/sec)",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "rate(http_server_requests_seconds_count{job=\"payment-router\"}[1m])",
          "legendFormat": "{{method}} {{uri}} {{status}}"
        }
      ]
    },
    {
      "id": 2,
      "title": "HTTP Response Time (p99)",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "histogram_quantile(0.99, rate(http_server_requests_seconds_bucket{job=\"payment-router\"}[1m]))",
          "legendFormat": "p99 {{uri}}"
        }
      ]
    },
    {
      "id": 3,
      "title": "Circuit Breaker State",
      "type": "stat",
      "gridPos": { "x": 0, "y": 8, "w": 8, "h": 6 },
      "targets": [
        {
          "expr": "resilience4j_circuitbreaker_state{job=\"payment-router\"}",
          "legendFormat": "{{name}}"
        }
      ]
    },
    {
      "id": 4,
      "title": "Circuit Breaker Failure Rate (%)",
      "type": "gauge",
      "gridPos": { "x": 8, "y": 8, "w": 8, "h": 6 },
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 100,
          "thresholds": {
            "steps": [
              { "color": "green", "value": 0 },
              { "color": "yellow", "value": 30 },
              { "color": "red", "value": 50 }
            ]
          }
        }
      },
      "targets": [
        {
          "expr": "resilience4j_circuitbreaker_failure_rate{job=\"payment-router\"}",
          "legendFormat": "{{name}}"
        }
      ]
    },
    {
      "id": 5,
      "title": "JVM Heap Memory Used",
      "type": "timeseries",
      "gridPos": { "x": 16, "y": 8, "w": 8, "h": 6 },
      "targets": [
        {
          "expr": "jvm_memory_used_bytes{job=\"payment-router\", area=\"heap\"}",
          "legendFormat": "{{id}}"
        }
      ]
    },
    {
      "id": 6,
      "title": "HTTP Error Rate (4xx/5xx)",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 14, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "rate(http_server_requests_seconds_count{job=\"payment-router\", status=~\"4..|5..\"}[1m])",
          "legendFormat": "{{status}} {{uri}}"
        }
      ]
    },
    {
      "id": 7,
      "title": "Active DB Connections",
      "type": "stat",
      "gridPos": { "x": 12, "y": 14, "w": 6, "h": 8 },
      "targets": [
        {
          "expr": "hikaricp_connections_active{job=\"payment-router\"}",
          "legendFormat": "Active"
        }
      ]
    },
    {
      "id": 8,
      "title": "JVM Threads",
      "type": "stat",
      "gridPos": { "x": 18, "y": 14, "w": 6, "h": 8 },
      "targets": [
        {
          "expr": "jvm_threads_live_threads{job=\"payment-router\"}",
          "legendFormat": "Live Threads"
        }
      ]
    }
  ]
}